# Copy to .env.local for local dev, and add the same variables in Vercel → Settings → Environment Variables.

# Turns on live AI answers in "Ask my AI". Without it, the assistant answers from your profile data.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-haiku-5-5 (fast and cheap, a good fit for this).
# ASK_MODEL=claude-haiku-5-5
